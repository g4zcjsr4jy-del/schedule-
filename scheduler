<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Тайм-менеджер — ИСУ 26дд-1</title>
  <style>
    :root {
      --bg: #f3f5f8;
      --card: #ffffff;
      --text: #111827;
      --muted: #6b7280;
      --border: #e5e7eb;
      --primary: #2563eb;
      --study-bg: #dbeafe;
      --study-border: #3b82f6;
      --study-text: #1e3a8a;
      --workout-bg: #d1fae5;
      --workout-border: #10b981;
      --workout-text: #065f46;
      --hw-bg: #fef3c7;
      --hw-border: #f59e0b;
      --hw-text: #78350f;
      --free-bg: #f9fafb;
      --sleep-bg: #eef2ff;
      --sleep-text: #4338ca;
      --radius: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      padding: 16px 14px 80px;
      line-height: 1.4;
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
    }

    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }

    h1 {
      font-size: 20px;
      font-weight: 700;
    }

    .subtitle {
      font-size: 13px;
      color: var(--muted);
    }

    .header-actions {
      display: flex;
      gap: 8px;
    }

    button {
      border: none;
      border-radius: 10px;
      padding: 9px 14px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
    }

    button:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-secondary {
      background: #e5e7eb;
      color: #1f2937;
    }

    .btn-danger {
      background: #fee2e2;
      color: #b91c1c;
    }

    /* Сводка времени */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }

    @media (min-width: 680px) {
      .stats-grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }

    .stat-card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 12px;
      border: 1px solid var(--border);
    }

    .stat-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      margin-bottom: 4px;
    }

    .stat-value {
      font-size: 17px;
      font-weight: 700;
    }

    .stat-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    /* Прогресс-бар недели */
    .bar-card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 14px;
      border: 1px solid var(--border);
      margin-bottom: 16px;
    }

    .bar-title {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
    }

    .progress-track {
      height: 14px;
      background: #e5e7eb;
      border-radius: 999px;
      overflow: hidden;
      display: flex;
    }

    .seg-sleep { background: #6366f1; }
    .seg-study { background: #3b82f6; }
    .seg-workout { background: #10b981; }
    .seg-hw { background: #f59e0b; }
    .seg-free { background: #d1d5db; }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    /* Переключатель видов и фильтры */
    .controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .tabs {
      display: flex;
      background: #e5e7eb;
      padding: 3px;
      border-radius: 10px;
    }

    .tab {
      background: transparent;
      color: #4b5563;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 13px;
    }

    .tab.active {
      background: #fff;
      color: #111827;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }

    /* Карточки дней */
    .days-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    @media (min-width: 760px) {
      .days-list {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .day-card {
      background: var(--card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 14px;
    }

    .day-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 10px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .day-name {
      font-size: 16px;
      font-weight: 700;
    }

    .day-free-badge {
      font-size: 12px;
      background: #ecfdf5;
      color: #047857;
      padding: 3px 8px;
      border-radius: 999px;
      font-weight: 600;
    }

    .events-stack {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .event-item {
      border-left: 4px solid;
      border-radius: 8px;
      padding: 9px 11px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .cat-study {
      background: var(--study-bg);
      border-color: var(--study-border);
      color: var(--study-text);
    }

    .cat-workout {
      background: var(--workout-bg);
      border-color: var(--workout-border);
      color: var(--workout-text);
    }

    .cat-hw {
      background: var(--hw-bg);
      border-color: var(--hw-border);
      color: var(--hw-text);
    }

    .event-time {
      font-size: 12px;
      font-weight: 700;
      opacity: 0.9;
    }

    .event-title {
      font-size: 14px;
      font-weight: 600;
      margin-top: 2px;
    }

    .event-meta {
      font-size: 12px;
      opacity: 0.85;
      margin-top: 2px;
    }

    .event-dur {
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
      opacity: 0.85;
    }

    .free-slot {
      border: 1px dashed #cbd5e1;
      background: var(--free-bg);
      color: #475569;
      border-radius: 8px;
      padding: 7px 11px;
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }

    .free-slot:hover {
      background: #f1f5f9;
      border-color: #94a3b8;
    }

    .sleep-note {
      font-size: 11px;
      color: var(--sleep-text);
      background: var(--sleep-bg);
      padding: 6px 10px;
      border-radius: 8px;
      text-align: center;
      font-weight: 500;
    }

    /* Таблица всей недели */
    .table-wrap {
      overflow-x: auto;
      background: var(--card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      display: none;
    }

    .table-wrap.active {
      display: block;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
      font-size: 12px;
    }

    th, td {
      border: 1px solid var(--border);
      padding: 8px;
      vertical-align: top;
      width: 14.28%;
    }

    th {
      background: #1f2937;
      color: #fff;
      font-weight: 600;
      text-align: center;
    }

    /* Модальное окно */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(17, 24, 39, 0.55);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 100;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal {
      background: #fff;
      border-radius: 16px;
      width: 100%;
      max-width: 420px;
      padding: 18px;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.15);
    }

    .modal h2 {
      font-size: 17px;
      margin-bottom: 14px;
    }

    .form-group {
      margin-bottom: 12px;
    }

    label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 4px;
    }

    input, select {
      width: 100%;
      padding: 9px 10px;
      border: 1px solid #d1d5db;
      border-radius: 9px;
      font-size: 14px;
      background: #fff;
    }

    .row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .modal-actions {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-top: 16px;
    }

    .modal-right {
      display: flex;
      gap: 8px;
    }
  </style>
</head>
<body>
<div class="container">
  <header>
    <div>
      <h1>Тайм-менеджер — ИСУ 26дд-1</h1>
      <div class="subtitle">Режим сна: 22:00 – 06:00 (8 ч/день) • Автосохранение</div>
    </div>
    <div class="header-actions">
      <button class="btn-secondary" onclick="resetSchedule()">Сбросить</button>
      <button class="btn-primary" onclick="openModal()">+ Добавить</button>
    </div>
  </header>

  <!-- Карточки статистики -->
  <div class="stats-grid" id="statsGrid"></div>

  <!-- Шкала баланса недели -->
  <div class="bar-card">
    <div class="bar-title">
      <span>Баланс недели (168 часов)</span>
      <span id="awakeLabel">Бодрствование: 112 ч</span>
    </div>
    <div class="progress-track" id="progressTrack"></div>
    <div class="legend">
      <div class="legend-item"><span class="dot seg-sleep"></span>Сон (56 ч)</div>
      <div class="legend-item"><span class="dot seg-study"></span>Учёба</div>
      <div class="legend-item"><span class="dot seg-workout"></span>Тренировки</div>
      <div class="legend-item"><span class="dot seg-hw"></span>Домашнее обучение</div>
      <div class="legend-item"><span class="dot seg-free"></span>Свободное время</div>
    </div>
  </div>

  <!-- Переключатели -->
  <div class="controls">
    <div class="tabs">
      <button class="tab active" id="tabCards" onclick="switchView('cards')">По дням (карточки)</button>
      <button class="tab" id="tabGrid" onclick="switchView('grid')">Вся неделя (таблица)</button>
    </div>
  </div>

  <!-- Вид 1: Карточки по дням -->
  <div class="days-list" id="daysContainer"></div>

  <!-- Вид 2: Таблица всей недели -->
  <div class="table-wrap" id="gridContainer">
    <table>
      <thead>
        <tr>
          <th>Пн</th>
          <th>Вт</th>
          <th>Ср</th>
          <th>Чт</th>
          <th>Пт</th>
          <th>Сб</th>
          <th>Вс</th>
        </tr>
      </thead>
      <tbody id="gridBody"></tbody>
    </table>
  </div>
</div>

<!-- Модальное окно редактирования -->
<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal">
    <h2 id="modalTitle">Новое занятие</h2>
    <input type="hidden" id="editId" />

    <div class="form-group">
      <label>День недели</label>
      <select id="fDay">
        <option value="0">Понедельник</option>
        <option value="1">Вторник</option>
        <option value="2">Среда</option>
        <option value="3">Четверг</option>
        <option value="4">Пятница</option>
        <option value="5">Суббота</option>
        <option value="6">Воскресенье</option>
      </select>
    </div>

    <div class="row-2 form-group">
      <div>
        <label>Начало</label>
        <input type="time" id="fStart" value="15:00" />
      </div>
      <div>
        <label>Конец</label>
        <input type="time" id="fEnd" value="16:00" />
      </div>
    </div>

    <div class="form-group">
      <label>Категория</label>
      <select id="fCat">
        <option value="study">Учёба (пары)</option>
        <option value="workout">Тренировка</option>
        <option value="hw">Домашнее обучение</option>
      </select>
    </div>

    <div class="form-group">
      <label>Название</label>
      <input type="text" id="fTitle" placeholder="Например: Высшая математика (ДЗ)" />
    </div>

    <div class="form-group">
      <label>Аудитория / Заметка</label>
      <input type="text" id="fMeta" placeholder="Например: ауд. 119 или Общежитие" />
    </div>

    <div class="modal-actions">
      <button class="btn-danger" id="btnDelete" onclick="deleteEvent()" style="display:none;">Удалить</button>
      <div class="modal-right" style="margin-left:auto;">
        <button class="btn-secondary" onclick="closeModal()">Отмена</button>
        <button class="btn-primary" onclick="saveEvent()">Сохранить</button>
      </div>
    </div>
  </div>
</div>

<script>
  const DAYS = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"];
  const STORAGE_KEY = "isu_26dd1_schedule_v1";

  const DEFAULT_EVENTS = [
    // Понедельник (0)
    { id: "1", day: 0, start: "08:30", end: "09:20", cat: "study", title: "Высшая математика (лек)", meta: "ауд. 119 (1/1) • Астамиров Р." },
    { id: "2", day: 0, start: "10:30", end: "11:20", cat: "study", title: "Иностранный язык (пр)", meta: "ауд. 422а/2 • Васильева О.М." },
    { id: "3", day: 0, start: "18:00", end: "19:15", cat: "workout", title: "Тренировка", meta: "1 ч 15 мин" },

    // Вторник (1)
    { id: "4", day: 1, start: "08:30", end: "09:20", cat: "study", title: "Иностранный язык (пр)", meta: "ауд. 836/УЛК • Васильева О.М." },
    { id: "5", day: 1, start: "10:30", end: "11:20", cat: "study", title: "Иностранный язык (пр)", meta: "ауд. 1013/УЛК • Васильева О.М." },

    // Среда (2)
    { id: "6", day: 2, start: "08:30", end: "09:20", cat: "study", title: "Иностранный язык (пр)", meta: "ауд. 1036/УЛК • Васильева О.М." },
    { id: "7", day: 2, start: "10:30", end: "11:20", cat: "study", title: "Модуль соц.-полит. знаний (пр)", meta: "ауд. 203/5 • Маликов А.В." },
    { id: "8", day: 2, start: "12:50", end: "13:40", cat: "study", title: "Введение в инф. системы (пр)", meta: "ауд. 636/УЛК • Ким Г.А." },
    { id: "9", day: 2, start: "18:00", end: "19:15", cat: "workout", title: "Тренировка", meta: "1 ч 15 мин" },

    // Четверг (3)
    { id: "10", day: 3, start: "08:30", end: "09:20", cat: "study", title: "Модуль соц.-полит. знаний (лек)", meta: "ауд. 119 (1/1) • Маликов А.В." },
    { id: "11", day: 3, start: "10:30", end: "11:20", cat: "study", title: "Введение в инф. системы (лек)", meta: "ауд. 119 (1/1) • Ким Г.А." },

    // Пятница (4)
    { id: "12", day: 4, start: "08:30", end: "09:20", cat: "study", title: "Экология и уст. развитие (лек)", meta: "ауд. 119 (1/1) • Гордиянова Т.В." },
    { id: "13", day: 4, start: "09:30", end: "10:20", cat: "study", title: "Модуль соц.-полит. знаний (лек)", meta: "ауд. 119 (1/1) • Маликов А.В." },
    { id: "14", day: 4, start: "10:30", end: "11:20", cat: "study", title: "Высшая математика (пр)", meta: "ауд. 1013/УЛК • Астамиров Р." },
    { id: "15", day: 4, start: "11:30", end: "12:20", cat: "study", title: "Высшая математика (пр)", meta: "ауд. 701/УЛК • Астамиров Р." },
    { id: "16", day: 4, start: "12:50", end: "13:40", cat: "study", title: "Основы экономики и фин. грам. (лек)", meta: "ауд. 119 (1/1) • Шайкин Д.Н." },
    { id: "17", day: 4, start: "14:50", end: "15:40", cat: "study", title: "Иностранный язык (пр)", meta: "ауд. 514а/4 • Васильева О.М." },
    { id: "18", day: 4, start: "18:00", end: "19:15", cat: "workout", title: "Тренировка", meta: "1 ч 15 мин" },

    // Суббота (5)
    { id: "19", day: 5, start: "08:30", end: "09:20", cat: "study", title: "Иностранный язык (пр)", meta: "ауд. 1005/УЛК • Васильева О.М." },
    { id: "20", day: 5, start: "12:50", end: "13:40", cat: "study", title: "Экология и уст. развитие (пр)", meta: "ауд. 1036/УЛК • Гордиянова Т.В." },
    { id: "21", day: 5, start: "13:50", end: "14:40", cat: "study", title: "Основы экономики и фин. грам. (пр)", meta: "ауд. 1036/УЛК • Шайкин Д.Н." }
  ];

  let events = JSON.parse(localStorage.getItem(STORAGE_KEY)) || JSON.parse(JSON.stringify(DEFAULT_EVENTS));

  function toMins(t) {
    const [h, m] = t.split(":").map(Number);
    return h * 60 + m;
  }

  function fromMins(m) {
    const hh = String(Math.floor(m / 60)).padStart(2, "0");
    const mm = String(m % 60).padStart(2, "0");
    return `${hh}:${mm}`;
  }

  function fmtDur(m) {
    if (m <= 0) return "0 мин";
    const h = Math.floor(m / 60);
    const min = m % 60;
    if (h === 0) return `${min} мин`;
    if (min === 0) return `${h} ч`;
    return `${h} ч ${String(min).padStart(2, "0")} м`;
  }

  function saveToStorage() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(events));
  }

  function render() {
    let studyMins = 0;
    let workoutMins = 0;
    let hwMins = 0;

    events.forEach(ev => {
      const dur = Math.max(0, toMins(ev.end) - toMins(ev.start));
      if (ev.cat === "study") studyMins += dur;
      else if (ev.cat === "workout") workoutMins += dur;
      else if (ev.cat === "hw") hwMins += dur;
    });

    const totalWeek = 168 * 60;
    const sleepMins = 56 * 60; // 22:00 - 06:00 (8 ч * 7 дней)
    const awakeMins = totalWeek - sleepMins; // 112 ч
    const busyMins = studyMins + workoutMins + hwMins;
    const freeMins = Math.max(0, awakeMins - busyMins);

    // Статистика
    document.getElementById("statsGrid").innerHTML = `
      <div class="stat-card">
        <div class="stat-label">Учёба (пары)</div>
        <div class="stat-value" style="color:var(--study-text)">${fmtDur(studyMins)}</div>
        <div class="stat-sub">${events.filter(e => e.cat === "study").length} занятий</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Тренировки</div>
        <div class="stat-value" style="color:var(--workout-text)">${fmtDur(workoutMins)}</div>
        <div class="stat-sub">${events.filter(e => e.cat === "workout").length} трен.</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Дом. обучение</div>
        <div class="stat-value" style="color:var(--hw-text)">${fmtDur(hwMins)}</div>
        <div class="stat-sub">Самоподготовка</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Сон (22–06)</div>
        <div class="stat-value" style="color:var(--sleep-text)">56 ч</div>
        <div class="stat-sub">8 ч / сутки</div>
      </div>
      <div class="stat-card" style="background:#ecfdf5; border-color:#a7f3d0;">
        <div class="stat-label" style="color:#065f46;">Свободно</div>
        <div class="stat-value" style="color:#047857;">${fmtDur(freeMins)}</div>
        <div class="stat-sub">Из 112 ч бодрств.</div>
      </div>
    `;

    // Шкала прогресса
    const pct = (m) => ((m / totalWeek) * 100).toFixed(2) + "%";
    document.getElementById("progressTrack").innerHTML = `
      <div class="seg-sleep" style="width:${pct(sleepMins)}" title="Сон: 56 ч"></div>
      <div class="seg-study" style="width:${pct(studyMins)}" title="Учёба: ${fmtDur(studyMins)}"></div>
      <div class="seg-workout" style="width:${pct(workoutMins)}" title="Тренировки: ${fmtDur(workoutMins)}"></div>
      <div class="seg-hw" style="width:${pct(hwMins)}" title="Домашнее обучение: ${fmtDur(hwMins)}"></div>
      <div class="seg-free" style="width:${pct(freeMins)}" title="Свободно: ${fmtDur(freeMins)}"></div>
    `;

    // Рендер дней (карточки)
    const daysContainer = document.getElementById("daysContainer");
    daysContainer.innerHTML = "";

    const DAY_START = 6 * 60;  // 06:00
    const DAY_END = 22 * 60;   // 22:00

    for (let d = 0; d < 7; d++) {
      const dayEvents = events
        .filter(e => e.day === d)
        .sort((a, b) => toMins(a.start) - toMins(b.start));

      let dayBusy = 0;
      dayEvents.forEach(e => {
        dayBusy += Math.max(0, toMins(e.end) - toMins(e.start));
      });
      const dayFree = Math.max(0, (DAY_END - DAY_START) - dayBusy);

      let stackHtml = `<div class="sleep-note">06:00 — Подъём</div>`;
      let cursor = DAY_START;

      dayEvents.forEach(ev => {
        const s = toMins(ev.start);
        const e = toMins(ev.end);

        if (s > cursor) {
          const gap = s - cursor;
          stackHtml += `
            <div class="free-slot" onclick="openModal(${d}, '${fromMins(cursor)}', '${fromMins(s)}')">
              <span>+ Свободно: ${fromMins(cursor)}–${fromMins(s)}</span>
              <strong>${fmtDur(gap)}</strong>
            </div>
          `;
        }

        const catClass = ev.cat === "study" ? "cat-study" : (ev.cat === "workout" ? "cat-workout" : "cat-hw");
        stackHtml += `
          <div class="event-item ${catClass}" onclick="editEvent('${ev.id}')">
            <div>
              <div class="event-time">${ev.start} – ${ev.end}</div>
              <div class="event-title">${ev.title}</div>
              ${ev.meta ? `<div class="event-meta">${ev.meta}</div>` : ""}
            </div>
            <div class="event-dur">${fmtDur(e - s)}</div>
          </div>
        `;
        cursor = Math.max(cursor, e);
      });

      if (cursor < DAY_END) {
        const gap = DAY_END - cursor;
        stackHtml += `
          <div class="free-slot" onclick="openModal(${d}, '${fromMins(cursor)}', '${fromMins(DAY_END)}')">
            <span>+ Свободно: ${fromMins(cursor)}–${fromMins(DAY_END)}</span>
            <strong>${fmtDur(gap)}</strong>
          </div>
        `;
      }

      stackHtml += `<div class="sleep-note">22:00 — Отбой (сон 8 ч)</div>`;

      const card = document.createElement("div");
      card.className = "day-card";
      card.innerHTML = `
        <div class="day-header">
          <div class="day-name">${DAYS[d]}</div>
          <div class="day-free-badge">Свободно: ${fmtDur(dayFree)}</div>
        </div>
        <div class="events-stack">${stackHtml}</div>
      `;
      daysContainer.appendChild(card);
    }

    // Рендер таблицы недели
    const gridBody = document.getElementById("gridBody");
    let rowHtml = "<tr>";
    for (let d = 0; d < 7; d++) {
      const dayEvents = events
        .filter(e => e.day === d)
        .sort((a, b) => toMins(a.start) - toMins(b.start));

      let cellHtml = "";
      dayEvents.forEach(ev => {
        const catClass = ev.cat === "study" ? "cat-study" : (ev.cat === "workout" ? "cat-workout" : "cat-hw");
        cellHtml += `
          <div class="event-item ${catClass}" style="margin-bottom:6px; padding:6px 8px;" onclick="editEvent('${ev.id}')">
            <div>
              <div class="event-time" style="font-size:11px;">${ev.start}–${ev.end}</div>
              <div class="event-title" style="font-size:12px;">${ev.title}</div>
            </div>
          </div>
        `;
      });
      if (!cellHtml) cellHtml = `<div style="color:#9ca3af; text-align:center; padding:12px 0;">Выходной</div>`;
      rowHtml += `<td>${cellHtml}</td>`;
    }
    rowHtml += "</tr>";
    gridBody.innerHTML = rowHtml;
  }

  function switchView(mode) {
    const cards = document.getElementById("daysContainer");
    const grid = document.getElementById("gridContainer");
    const tCards = document.getElementById("tabCards");
    const tGrid = document.getElementById("tabGrid");

    if (mode === "cards") {
      cards.style.display = "grid";
      grid.classList.remove("active");
      tCards.classList.add("active");
      tGrid.classList.remove("active");
    } else {
      cards.style.display = "none";
      grid.classList.add("active");
      tCards.classList.remove("active");
      tGrid.classList.add("active");
    }
  }

  function openModal(day = 0, start = "15:00", end = "16:30") {
    document.getElementById("modalTitle").textContent = "Добавить занятие";
    document.getElementById("editId").value = "";
    document.getElementById("fDay").value = day;
    document.getElementById("fStart").value = start;
    document.getElementById("fEnd").value = end;
    document.getElementById("fCat").value = "hw";
    document.getElementById("fTitle").value = "";
    document.getElementById("fMeta").value = "";
    document.getElementById("btnDelete").style.display = "none";
    document.getElementById("modalBackdrop").classList.add("open");
  }

  function editEvent(id) {
    const ev = events.find(e => e.id === id);
    if (!ev) return;
    document.getElementById("modalTitle").textContent = "Редактировать";
    document.getElementById("editId").value = ev.id;
    document.getElementById("fDay").value = ev.day;
    document.getElementById("fStart").value = ev.start;
    document.getElementById("fEnd").value = ev.end;
    document.getElementById("fCat").value = ev.cat;
    document.getElementById("fTitle").value = ev.title;
    document.getElementById("fMeta").value = ev.meta || "";
    document.getElementById("btnDelete").style.display = "inline-block";
    document.getElementById("modalBackdrop").classList.add("open");
  }

  function closeModal() {
    document.getElementById("modalBackdrop").classList.remove("open");
  }

  function saveEvent() {
    const id = document.getElementById("editId").value;
    const day = Number(document.getElementById("fDay").value);
    const start = document.getElementById("fStart").value;
    const end = document.getElementById("fEnd").value;
    const cat = document.getElementById("fCat").value;
    const title = document.getElementById("fTitle").value.trim() || "Занятие";
    const meta = document.getElementById("fMeta").value.trim();

    if (toMins(end) <= toMins(start)) {
      alert("Время окончания должно быть позже времени начала.");
      return;
    }

    if (id) {
      const idx = events.findIndex(e => e.id === id);
      if (idx !== -1) events[idx] = { id, day, start, end, cat, title, meta };
    } else {
      events.push({ id: String(Date.now()), day, start, end, cat, title, meta });
    }

    saveToStorage();
    closeModal();
    render();
  }

  function deleteEvent() {
    const id = document.getElementById("editId").value;
    events = events.filter(e => e.id !== id);
    saveToStorage();
    closeModal();
    render();
  }

  function resetSchedule() {
    if (confirm("Вернуть исходное расписание ИСУ 26дд-1?")) {
      events = JSON.parse(JSON.stringify(DEFAULT_EVENTS));
      saveToStorage();
      render();
    }
  }

  document.getElementById("modalBackdrop").addEventListener("click", (e) => {
    if (e.target.id === "modalBackdrop") closeModal();
  });

  render();
</script>
</body>
</html>
